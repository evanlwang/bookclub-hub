DATABASE_URL="postgresql://user:password@localhost:5432/bookclub_hub"
DIRECT_URL="postgresql://user:password@localhost:5432/bookclub_hub"
RESEND_API_KEY="re_xxxxxxxxxxxx"
OPEN_LIBRARY_BASE_URL="https://openlibrary.org"
CRON_SECRET="your-secret-here"

# Friends-pilot gate. When set, /login, /join (auth.enter) and the unauth
# branch of clubs.join all require this exact string. Leave UNSET in local
# dev — the dev-bypass keeps the seeded test accounts working without a
# passcode prompt. Set on production (Vercel) before sharing the URL.
PILOT_PASSCODE=""
